table DimProduto

	column ProductID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = Automatic

	column NomeProduto
		dataType: string
		summarizeBy: none
		sourceColumn: NomeProduto

		annotation SummarizationSetBy = Automatic

	column Subcategoria
		dataType: string
		summarizeBy: none
		sourceColumn: Subcategoria

		annotation SummarizationSetBy = Automatic

	column Categoria
		dataType: string
		summarizeBy: none
		sourceColumn: Categoria

		annotation SummarizationSetBy = Automatic

	column ProductNumber
		dataType: string
		summarizeBy: none
		sourceColumn: ProductNumber

		annotation SummarizationSetBy = Automatic

	column Color
		dataType: string
		summarizeBy: none
		sourceColumn: Color

		annotation SummarizationSetBy = Automatic

	column StandardCost
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: sum
		sourceColumn: StandardCost

		annotation SummarizationSetBy = Automatic

	column ListPrice
		dataType: decimal
		formatString: #,##0.00
		summarizeBy: sum
		sourceColumn: ListPrice

		annotation SummarizationSetBy = Automatic

	column SellStartDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: SellStartDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column SellEndDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: SellEndDate

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column FinishedGoodsFlag
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		summarizeBy: none
		sourceColumn: FinishedGoodsFlag

		annotation SummarizationSetBy = Automatic

	partition DimProduto = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("localhost\SQLEXPRESS", "AdventureWorks2022"),
				    dbo_vw_DimProduto = Fonte{[Schema="dbo",Item="vw_DimProduto"]}[Data],
				    #"Tipo Alterado" = Table.TransformColumnTypes(dbo_vw_DimProduto,{{"SellStartDate", type date}, {"SellEndDate", type date}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

