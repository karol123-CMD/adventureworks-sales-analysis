table 'Aparencia PoC'
	lineageTag: 5d8f85d5-6f02-4a3f-84ac-4d329dc21ec6

	measure 'PoC Cor Receita' = ```
			
			  VAR ModoSelecionado =
			      SELECTEDVALUE('Aparencia PoC'[Modo], "Claro")
			  RETURN
			      IF(
			          ModoSelecionado = "Escuro",
			          "#61D4E5",
			          "#0069D2"
			      )
			```
